{
  "name": "padel-one",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node Test/scripts/smoke-test.js",
    "test:smoke:seeded": "SMOKE_USE_SEEDED_USERS=true node Test/scripts/smoke-test.js",
    "smoke:staging": "node scripts/smoke-staging-url.js",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "security:env": "node scripts/check-committed-env-files.js && node scripts/check-env-templates.js",
    "security:agents": "node scripts/agent-safety-check.js",
    "security:secrets": "node scripts/check-committed-env-files.js",
    "security:migrations": "node scripts/check-migration-safety.js",
    "security:runbooks": "node scripts/check-backup-restore-runbooks.js",
    "security:ci": "npm run security:env && npm run security:agents && npm run security:migrations && npm run security:runbooks",
    "backup:dry-run": "node scripts/check-backup-restore-runbooks.js",
    "restore:dry-run": "node scripts/check-backup-restore-runbooks.js",
    "staging:preflight": "node scripts/staging-preflight.js",
    "production:preflight": "node scripts/production-preflight.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "framer-motion": "^10.16.4",
    "html-to-image": "^1.11.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.4.5",
    "jsdom": "^29.0.2",
    "msw": "^2.14.6",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4",
    "workbox-window": "^7.4.0"
  }
}
